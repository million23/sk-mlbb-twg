# PocketBase / PocketHost URL (legacy, being replaced by Supabase)
# Copy to .env and set your URL.
VITE_POCKETHOST_URL=

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (public registration bot check)
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
# NEVER put the secret in VITE_* (it would ship to the browser).
# Set TURNSTILE_SECRET_KEY on the PocketHost instance env only, then restart.

# Resend — registration status-code email after participants POST
VITE_RESEND_API_KEY=
VITE_RESEND_FROM=

# Public website hosts (no protocol ok). Used for docs / allowlist awareness.
# Registration emails use window.location.origin from the submitting browser,
# then PocketBase allowlists it (see pb_hooks/sk_mail.js + SK_APP_ORIGINS).
VITE_WEBSITE_URL_BETA=
VITE_WEBSITE_URL_MAIN=
# Optional absolute origin override when window is unavailable

# On PocketHost (server env, not Vite):
# - Set Settings → Application URL to your production site (approve/reject mail).
#   Never put the Discord webhook URL in VITE_* — PocketHost server-only.

# Smoke create-team registration (bun run smoke:create-team)
# SMOKE_TOURNAMENT_ID=
# SMOKE_TEAM_SIZE=2
# SMOKE_TEAM_NAME=Smoke Squad
# SMOKE_EMAIL_BASE=
